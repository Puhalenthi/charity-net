# Emulator mode: the SDK requires these to be NON-EMPTY but never validates them
# against Google — the placeholders below work as-is with VITE_USE_EMULATORS=true.
# (Only swap in real values from the Firebase console if you point at live Firebase.)
VITE_FIREBASE_API_KEY=emulator-fake-key
VITE_FIREBASE_AUTH_DOMAIN=charity-net-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=charity-net-dev
VITE_FIREBASE_STORAGE_BUCKET=charity-net-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:emulator

# Dev proxy target for /api → server
VITE_API_TARGET=http://localhost:8080
VITE_API_BASE_URL=/api

VITE_GOOGLE_MAPS_KEY=

# Emulator flags (set to 'true' to wire local emulators)
VITE_USE_EMULATORS=true
